# Server Configuration
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/campusai
MONGODB_DB_NAME=campusai

# For MongoDB Atlas, replace MONGODB_URI with your Atlas connection string.
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@YOUR_CLUSTER.mongodb.net/campusai?retryWrites=true&w=majority

# Session Secret (generate a secure random string of at least 32 characters)
SESSION_SECRET=replace_with_a_secure_random_secret

# Google Cloud OAuth Credentials
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Optional: restrict access to a specific verified email domain
# Leave empty to allow any verified .edu address, if supported by your app.
ALLOWED_EMAIL_DOMAIN=

# Token Encryption Key
# Generate 32 random bytes and encode them as Base64.
TOKEN_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Storage Configuration
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# Optional Development Seed Accounts
SEED_TEACHER_EMAIL=teacher@example.edu
SEED_TEACHER_PASSWORD=
SEED_STUDENT_EMAIL=student@example.edu
SEED_STUDENT_PASSWORD=

# Optional: One-time account role assignment
ROLE_EMAIL=
ROLE_TO_SET=teacher