
# Server Configuration
PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb+srv://USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/campusai?retryWrites=true&w=majority
MONGODB_DB_NAME=campusai

# Session Secret (minimum 32 characters)
SESSION_SECRET=replace_with_a_secure_random_secret

# Google Cloud OAuth Credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Optional: Restrict access to a verified email domain
ALLOWED_EMAIL_DOMAIN=

# Token Encryption Key (32 random bytes, Base64 encoded)
TOKEN_ENCRYPTION_KEY=your_base64_encoded_32_byte_key

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Storage Configuration
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# Optional Development Seed Accounts
SEED_TEACHER_EMAIL=teacher@example.edu
SEED_TEACHER_PASSWORD=replace_with_a_strong_password
SEED_STUDENT_EMAIL=student@example.edu
SEED_STUDENT_PASSWORD=replace_with_a_strong_password

# Optional: One-time account role assignment
ROLE_EMAIL=
ROLE_TO_SET=teacher
