# Server Configuration
PORT=3000
NODE_ENV=development

# MongoDB Atlas Connection String (Replace with your own cluster URI in .env)
MONGODB_URI=mongodb+srv://placeholder_user:placeholder_password@cluster0.example.mongodb.net/chaos_engine?retryWrites=true&w=majority
MONGODB_DB_NAME=chaos_engine

# Session Secret (Generate a long random string, min 32 chars)
SESSION_SECRET=replace_with_a_long_random_64_character_hex_secret_for_sessions

# Google Gemini API Configuration (Server-side only)
GEMINI_API_KEY=AIzaSy_PLACEHOLDER_REPLACE_WITH_YOUR_ACTUAL_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-flash

# Storage Configuration
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=5242880

# Seed Account Passwords (Used only by scripts/seed.js in development)
SEED_TEACHER_PASSWORD=TeacherPass123!
SEED_STUDENT_PASSWORD=StudentPass123!